{
  "name": "hr-resume-screening-assistant",
  "version": "2.8.4",
  "description": "HR筛选简历助手 Windows 单机独立版",
  "main": "app.js",
  "author": "dazhahui",
  "scripts": {
    "start": "electron app.js",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.hrassistant.standalone",
    "productName": "HR筛选简历助手",
    "artifactName": "HR筛选简历助手-Setup-${version}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "app.js",
      "preload.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-backend",
        "to": "backend"
      },
      {
        "from": "../config/keywords.json",
        "to": "app-root/config/keywords.json"
      },
      {
        "from": "../web/dist",
        "to": "app-root/web/dist"
      },
      {
        "from": "../package.json",
        "to": "app-root/package.json"
      },
      {
        "from": "../node_modules/@napi-rs/canvas",
        "to": "backend/node_modules/@napi-rs/canvas"
      },
      {
        "from": "../node_modules/@napi-rs/canvas-win32-x64-msvc",
        "to": "backend/node_modules/@napi-rs/canvas-win32-x64-msvc"
      },
      {
        "from": "node_modules/browserwing/bin/browserwing.exe",
        "to": "browserwing/browserwing.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "browserwing": "1.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
