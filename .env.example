# 可选 AI；留空时使用降级评分
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.6-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本机服务与受控浏览器，仅监听回环地址
BROWSERWING_PORT=7777
SERVER_PORT=3000

# 可选 Markdown JD 首次导入目录
JD_DIR=./jds

ACTION_DELAY_MS=3000
CARD_INTERVAL_MS=3500
DIALOG_DELAY_MS=2000
MAX_CANDIDATES=50
